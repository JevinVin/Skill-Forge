# Environment Variables for the Backend Service
# Copy this file to .env and fill in your own values.
# The defaults below match the docker-compose.yml setup for local development.

# ── Database ─────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/learningplatform
DB_USERNAME=lpuser
DB_PASSWORD=lppassword

# ── JWT ──────────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a secure random 256-bit (32+ char) secret in production.
JWT_SECRET=dev-only-secret-replace-in-prod-must-be-256-bit-key-padded
JWT_EXPIRATION_MS=86400000

# ── Server ───────────────────────────────────────────────────────────────
SERVER_PORT=8080
